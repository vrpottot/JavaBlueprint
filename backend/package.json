{
  "name": "javablueprint-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test --config=playwright.config.ts",
    "demo": "tsx scripts/demo.ts",
    "runner:build": "docker build -t javablueprint-runner:local -f runner/Dockerfile ."
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
