{
  "name": "javablueprint-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ci": "tsx --test --test-concurrency=1 tests/api.test.ts tests/complexity.test.ts tests/advanced-complexity.test.ts tests/deploy.test.ts tests/methods.test.ts tests/ai-context.test.ts tests/editor.test.ts tests/control-flow.test.ts",
    "test:frontend": "tsx --test ../frontend/tests/*.test.ts",
    "test:gateway": "tsx scripts/check-gateway.mjs",
    "test:browser": "playwright test --config=playwright.config.ts",
    "demo": "tsx scripts/demo.ts",
    "stress:mission": "tsx scripts/stress-mission.ts",
    "stress:mission:browser": "tsx scripts/stress-mission-browser.ts",
    "check:analysis": "tsx scripts/check-analysis.ts",
    "audit:jury": "tsx scripts/jury-audit.ts",
    "audit:jury:browser": "tsx scripts/jury-browser.ts",
    "audit:jury:api": "tsx scripts/jury-api.ts",
    "audit:jury:palette": "tsx scripts/jury-palette.ts",
    "audit:jury:templates": "tsx scripts/jury-palette-contracts.ts",
    "audit:jury:png": "tsx scripts/jury-png.ts",
    "runner:build": "docker build -t javablueprint-runner:local -f runner/Dockerfile ."
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.2",
    "@fastify/cors": "^11.0.1",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3"
  }
}
